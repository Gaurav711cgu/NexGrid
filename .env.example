# NexGrid Environment Configuration
# Copy this to .env and fill in all values before running the application.
# DO NOT commit your actual .env file.

# ─── Required ─────────────────────────────────────────────────────────────────

# JWT signing secret — MUST be set. No default. Min 32 chars.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ─── Environment ──────────────────────────────────────────────────────────────

ENVIRONMENT=development
# Options: development | staging | production
# production: enables secure cookie, disables /docs and /redoc

# ─── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Example for production: CORS_ALLOWED_ORIGINS=https://nexgrid.vercel.app

# ─── Database ─────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://postgres:changeme@localhost:5432/nexagrid

# ─── Redis ────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379/0

# ─── AI Service ───────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_PROMPT_VERSION=v1

# ─── Sandbox ──────────────────────────────────────────────────────────────────

MAX_MEMORY_MB=128
EXECUTION_TIMEOUT_SECONDS=10
