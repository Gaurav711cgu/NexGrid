{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Active WebSocket Connections",
      "type": "stat",
      "targets": [{ "expr": "ws_connections_active_total", "legendFormat": "Connections" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "thresholds": {
        "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 150 },
          { "color": "red", "value": 200 }
        ]
      }
    },
    {
      "title": "CRDT Operations / Sec",
      "type": "timeseries",
      "targets": [{ "expr": "rate(crdt_ops_total[1m])", "legendFormat": "Ops/sec" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }
    },
    {
      "title": "Code Execution Latency (P95)",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(code_execution_seconds_bucket[5m])) by (le))", "legendFormat": "P95 Latency (s)" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }
    },
    {
      "title": "Blocked Code Executions (Security Alert)",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(code_executions_blocked_total[5m]))", "legendFormat": "Blocked Attempts/5m" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "thresholds": {
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 10 }
        ]
      }
    },
    {
      "title": "AI Completion Latency (P90)",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.90, sum(rate(ai_completion_seconds_bucket[5m])) by (le))", "legendFormat": "P90 Latency (s)" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 }
    },
    {
      "title": "AI Circuit Breaker State (0=Closed, 1=Open)",
      "type": "stat",
      "targets": [{ "expr": "circuit_breaker_state", "legendFormat": "State" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "thresholds": {
        "steps": [
          { "color": "green", "value": 0 },
          { "color": "red", "value": 1 },
          { "color": "yellow", "value": 2 }
        ]
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["nexagrid", "faang", "telemetry", "alerts"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "NexaGrid Real-Time Telemetry & Alerting Dashboard"
}
