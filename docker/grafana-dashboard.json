      "title": "Active WebSocket Connections",
      "type": "stat",
      "targets": [{ "expr": "sum(ws_connections_active)", "legendFormat": "Connections" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "title": "CRDT Operations / Sec",
      "type": "timeseries",
      "targets": [{ "expr": "rate(crdt_ops_total[1m])", "legendFormat": "Ops/sec" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }
    },
    {
      "title": "Code Execution Latency (P95)",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(code_execution_seconds_bucket[5m])) by (le))", "legendFormat": "P95 Latency (s)" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }
    },
    {
      "title": "Blocked Code Executions (Security)",
      "type": "stat",
      "targets": [{ "expr": "sum(code_executions_blocked_total)", "legendFormat": "Blocked Attempts" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "title": "AI Completion Latency (P90)",
      "type": "timeseries",
